<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_veterinaria" model="ir.module.category">
        <field name="name">Veterinaria</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_vet_recepcion" model="res.groups">
        <field name="name">Recepcionista</field>
        <field name="category_id" ref="module_category_veterinaria"/>
    </record>

    <record id="group_vet_veterinario" model="res.groups">
        <field name="name">Veterinario</field>
        <field name="category_id" ref="module_category_veterinaria"/>
        <field name="implied_ids" eval="[(4, ref('group_vet_recepcion'))]"/>
    </record>

    <record id="group_vet_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_veterinaria"/>
        <field name="implied_ids" eval="[(4, ref('group_vet_veterinario'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
