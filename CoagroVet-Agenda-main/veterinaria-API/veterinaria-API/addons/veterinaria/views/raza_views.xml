<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vet_raza_view_list" model="ir.ui.view">
        <field name="name">vet.raza.list</field>
        <field name="model">vet.raza</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="especie_id"/>
            </list>
        </field>
    </record>

    <record id="vet_raza_view_form" model="ir.ui.view">
        <field name="name">vet.raza.form</field>
        <field name="model">vet.raza</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="especie_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vet_raza_action" model="ir.actions.act_window">
        <field name="name">Razas</field>
        <field name="res_model">vet.raza</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
