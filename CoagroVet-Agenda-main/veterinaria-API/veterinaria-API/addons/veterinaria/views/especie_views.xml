<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vet_especie_view_list" model="ir.ui.view">
        <field name="name">vet.especie.list</field>
        <field name="model">vet.especie</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="vet_especie_view_form" model="ir.ui.view">
        <field name="name">vet.especie.form</field>
        <field name="model">vet.especie</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Razas">
                            <field name="raza_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vet_especie_action" model="ir.actions.act_window">
        <field name="name">Especies</field>
        <field name="res_model">vet.especie</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
